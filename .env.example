# Anthropic API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=
# 使用モデル（省略時 claude-opus-5-5）
CLAUDE_MODEL=claude-opus-5-5

# YouTube Data API v3 キー（Google Cloud Console で発行）
YOUTUBE_API_KEY=

# Supabase（Project Settings > API）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# アプリのパスワード（自分専用にするための簡易ロック。空ならロックなし）
APP_PASSWORD=
